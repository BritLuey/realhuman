{
  "name": "@realhuman/jev",
  "version": "0.1.0",
  "description": "Optional Jev engine for realHuman: TypeSafe AI decisions via Vercel AI Gateway, OpenRouter or TypeSafe directly.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/realhuman.git",
    "directory": "packages/jev"
  },
  "homepage": "https://github.com/your-org/realhuman#readme",
  "bugs": "https://github.com/your-org/realhuman/issues",
  "keywords": [
    "realhuman",
    "bot-detection",
    "analytics"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/write-version.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/write-version.mjs && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@realhuman/engine": "workspace:^"
  },
  "peerDependencies": {
    "ai": ">=7"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ai": "^7.0.127",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
