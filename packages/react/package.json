{
  "name": "@realhuman/react",
  "version": "0.0.0",
  "description": "React provider and hook for the realHuman browser SDK.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/realhuman.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/your-org/realhuman#readme",
  "bugs": "https://github.com/your-org/realhuman/issues",
  "keywords": [
    "realhuman",
    "bot-detection",
    "analytics"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/write-version.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/write-version.mjs && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@realhuman/client": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
