{
  "name": "@realhuman/schema",
  "version": "0.1.0",
  "description": "Wire-format schemas and types shared by every realHuman package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/realhuman.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/your-org/realhuman/tree/main/docs/reference/data-formats.md",
  "bugs": "https://github.com/your-org/realhuman/issues",
  "keywords": [
    "realhuman",
    "bot-detection",
    "analytics",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
