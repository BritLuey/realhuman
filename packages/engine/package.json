{
  "name": "@realhuman/engine",
  "version": "0.1.0",
  "description": "realHuman scoring engine: session nonces, gates, evidence scoring and decision records. Runs anywhere with Web-standard APIs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/realhuman.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/your-org/realhuman#readme",
  "bugs": "https://github.com/your-org/realhuman/issues",
  "keywords": [
    "realhuman",
    "bot-detection",
    "analytics",
    "ja4",
    "edge"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "realhuman-rescore": "./bin/realhuman-rescore.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/write-version.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/write-version.mjs && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@realhuman/schema": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
