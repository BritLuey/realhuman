# Required: signs session nonces. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
REALHUMAN_SECRET=

# Optional: enables GET /api/export for the evaluation tool. Use a long random value.
DEMO_ADMIN_TOKEN=

# Optional: added automatically when you connect "Upstash for Redis" from the Vercel Marketplace.
# Enables the "Why this score?" panel and stored records for evaluation.
KV_REST_API_URL=
KV_REST_API_TOKEN=
